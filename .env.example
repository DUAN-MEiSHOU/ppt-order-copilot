# ============================================================
# Optional: point these at any OpenAI-compatible endpoint.
# Leave blank to run the fully offline deterministic demo/eval mode.
# ============================================================
# DeepSeek:   LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1     LLM_MODEL=qwen2.5:7b  (no key needed)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# Optional cost model used for trace estimates (USD per 1M tokens)
COST_INPUT_PER_MTOK=0.28
COST_OUTPUT_PER_MTOK=0.42
